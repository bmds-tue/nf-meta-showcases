// r08_ampliseq -- nf-core/ampliseq 2.18.0
//
// FORMAT_TAXONOMY points at a legacy containers.biocontainers.pro .img image whose
// Singularity pull hangs after the download (nf-core/ampliseq#1081, fixed in 3.0.0).
// Pulling the Docker image instead is upstream's workaround (runs/08_ampliseq/README.md).
process {
    withName: '.*:FORMAT_TAXONOMY' {
        ext.singularity_pull_docker_container = true
    }
}
