// Applied to every step (globals.nf_config in metaomics.yaml).
//
// A resumed run keeps its session timestamp, so pipeline_info/execution_*_<ts>.html
// already exists and Nextflow aborts the report render. Upstream needed this on every
// pipeline (vagkaratzas/meta-omics-sig runs/01_fetchngs/README.md, "Known gotchas").
report.overwrite   = true
timeline.overwrite = true
trace.overwrite    = true
dag.overwrite      = true

// NOT settable here, although upstream needed them -- both are read by the Nextflow
// launcher before any config file is parsed, so export them for the whole nf-meta run:
//
//   NXF_SYNTAX_PARSER=v1  fetchngs 1.12.0 (`def check_max` in nextflow.config) and
//                         detaxizer 1.3.0 (statements mixed with declarations) fail to
//                         parse otherwise on Nextflow >= 26.04. Every other pipeline in
//                         this metapipeline also parses under v1.
//   NXF_OPTS="-Xms2g -Xmx16g"
//                         r06_proteinfamilies_mg: the head JVM ran out of heap
//                         submitting MERGE_SEEDS tasks for ~2.5 M proteins
//                         (nf-core/proteinfamilies#191, fixed in 2.6.0, not in 2.5.0).
