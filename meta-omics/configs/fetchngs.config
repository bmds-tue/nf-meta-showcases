// r01_fetchngs -- nf-core/fetchngs 1.12.0
//
// The wget:1.20.1 image SRA_FASTQ_FTP uses ships without /etc/resolv.conf, so under
// Singularity/Apptainer the resolver bind is skipped and every download dies with wget
// exit 4. Upstream's fix (runs/01_fetchngs/README.md); the module's flags
// (-t 5 -nv -c -T 60 -O) all exist in wget 1.18. Fixed in fetchngs 1.13.0.
process {
    withName: 'SRA_FASTQ_FTP' {
        container = 'quay.io/biocontainers/gnu-wget:1.18--h60da905_7'
    }
}

// Also required, but not settable here: NXF_SYNTAX_PARSER=v1 (see global.config).
