// r02_metatdenovo, x01_metatdenovo_filtered -- nf-core/metatdenovo 1.4.0
//
// MEGAHIT_INTERLEAVED carries only the label `process_high_memory`, which sets memory
// (200 GB) but no cpus, so the task falls back to the process default of 1 CPU and
// MEGAHIT runs with `-t 1` (first seen on a local run: ~3 h for the k=21 step alone).
// Give it process_high's CPUs. Site limits (process.resourceLimits) still cap both.
process {
    withName: '.*:MEGAHIT_INTERLEAVED' {
        cpus = { 12 * task.attempt }
    }
}
