// Shared by every connector in this folder: each connector's nextflow.config does
// `includeConfig '../base.config'`. Nextflow resolves that relative to the including
// file, so it works both when a connector is run from a local checkout (`path:` in
// the metapipeline) and when it is pulled from GitHub (`url:` + `main_script:`) --
// in the second case Nextflow clones the whole repository and still loads the
// nextflow.config sitting next to the main script.

plugins {
    id 'nf-schema@2.7.3'
}

validation {
    help {
        enabled = true
    }
    // Set by nf-core/configs institutional profiles, not by the connector's own schema.
    ignoreParams = ['custom_config_version', 'custom_config_base', 'config_profile_name',
                    'config_profile_description', 'config_profile_contact', 'config_profile_url']
}

params {
    help                       = false
    outdir                     = null
    // nf-core/configs institutional profiles (e.g. -profile ccga_cau, denbi_qbic)
    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_name        = null
    config_profile_description = null
    config_profile_contact     = null
    config_profile_url         = null
}

// The converters are plain Python 3 (standard library only). The image is written
// with its registry so the `*.registry = 'quay.io'` defaults below don't rewrite it.
process {
    conda     = 'conda-forge::python=3.12'
    container = 'docker.io/library/python:3.12-slim'
}

// Same profile names as the nf-core template, so the -profile string nf-meta hands
// every step of the metapipeline also resolves here.
profiles {
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        conda.channels          = ['conda-forge', 'bioconda']
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
}

includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'
